# =============================================================================
# Hermes Agent — Zeabur Deployment Environment Variables
# Copy this and fill in your values in the Zeabur dashboard
# =============================================================================

# ── Model Provider (Nous Portal) ──
# These are from your local ~/.hermes/.env — copy them to Zeabur
# NOUS_API_KEY=your-nous-api-key
# Or use OpenRouter:
# OPENROUTER_API_KEY=your-openrouter-key

# ── Feishu Platform ──
FEISHU_APP_ID=cli_a955a5373f38dcd4
FEISHU_APP_SECRET=your-feishu-app-secret
FEISHU_DOMAIN=feishu
FEISHU_CONNECTION_MODE=websocket
FEISHU_ALLOW_ALL_USERS=false
FEISHU_ALLOWED_USERS=
FEISHU_GROUP_POLICY=open

# ── Hermes Home ──
HERMES_HOME=/opt/data
